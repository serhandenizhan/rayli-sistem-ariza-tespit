# NLP metin sınıflandırma servisi (BERTurk + LoRA, FastAPI). Sensör API'sinden (Dockerfile.api)
# AYRI bir imaj çünkü bağımlılıkları (transformers, peft, torch) çok daha ağır ve tamamen farklı
# bir requirements.txt kullanıyor — tek imajda birleştirmek gereksiz büyütür ve sensör tarafının
# hafif kalma amacını bozardı (bkz. CLAUDE.md "Backend mimarisi" kararı).
FROM python:3.11-slim

WORKDIR /app/nlp

COPY nlp/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# LoRA adaptörü + veri seti küçük (~8 MB), imaja gömülü — yeniden eğitim gerekmeden çalışır.
COPY nlp/ .

EXPOSE 8001
ENTRYPOINT ["/app/nlp/docker-entrypoint.sh"]
