# Next.js dashboard. İki aşamalı derleme: bağımlılıklar+build ayrı katmanda, çalışma zamanı
# imajı yalnızca üretim çıktısını taşır (daha küçük imaj).
FROM node:20-slim AS derleme
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ .
# ÖNEMLİ: Next.js `rewrites()` sonucunu BUILD ANINDA hesaplayıp .next/routes-manifest.json'a
# gömer — `next start` bunu runtime'da yeniden ÇAĞIRMAZ. Yani docker-compose.yml'deki
# `environment: AKIS_API_URL` konteynerde doğru görünse bile hiçbir etkisi olmaz; proxy hedefi
# burada, derleme sırasında sabitlenmelidir. Servis adları (api, api-nlp) docker-compose.yml
# tarafından zaten sabit olduğu için bunu build-time'da gömmek bir geçici çözüm değil, doğru
# yaklaşımdır.
ENV AKIS_API_URL=http://api:8000
ENV NLP_API_URL=http://api-nlp:8001
RUN npm run build

FROM node:20-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=derleme /app/package.json ./package.json
COPY --from=derleme /app/node_modules ./node_modules
COPY --from=derleme /app/.next ./.next
COPY --from=derleme /app/next.config.mjs ./next.config.mjs

EXPOSE 3000
# AKIS_API_URL, docker-compose.yml içinde servis adıyla (http://api:8000) verilir —
# next.config.mjs bu adresi rewrite hedefi olarak okur, tarayıcı doğrudan API'yi görmez.
CMD ["npx", "next", "start", "-p", "3000"]
